{
  "name": "rutaviva",
  "version": "1.0.0",
  "description": "Prototipo de navegación adaptativa para vehículos de emergencia con re-enrutamiento en tiempo real (Strategy, Observer, Command, Composite, Iterator, Decorator).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "benchmark": "tsx src/benchmark/benchmark.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
